{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cypress": "cross-env CYPRESS=true vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "prepare": "cypress install",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache --max-warnings=0",
    "format": "prettier --write --experimental-cli src/",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "cypress:open": "cypress open",
    "cypress:run:component": "cypress run --component",
    "cypress:run:e2e": "start-server-and-test dev:cypress http://localhost:5173 'cypress run --e2e'"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vee-validate/zod": "^4.15.1",
    "axios": "^1.18.1",
    "pinia": "^4.0.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@cypress/vue": "^6.0.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "axios-mock-adapter": "^2.1.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.18.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-oxlint": "~1.75.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.75.0",
    "prettier": "3.9.5",
    "sass-embedded": "^1.100.0",
    "start-server-and-test": "^3.0.11",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "nyc": {
    "report-dir": "cypress-coverage",
    "reporter": [
      "lcov",
      "text-summary"
    ]
  }
}
