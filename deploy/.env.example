# Modelo do deploy/.env (ver deploy/README.md). Copie para deploy/.env e preencha.
# O deploy/.env NUNCA vai para o Git (está no .gitignore): ele guarda os segredos de produção.
# Guarde uma cópia dos valores no seu gerenciador de senhas.

# Domínio público. Em produção: eusindicogestao.com.br. Na validação local: localhost.
SITE_DOMAIN=eusindicogestao.com.br

# E-mail informado ao Let's Encrypt para avisos sobre os certificados HTTPS.
ACME_EMAIL=eusindico.contato@gmail.com

# Imagens publicadas pelo GitHub Actions no ECR (a tag é definida pelo workflow de deploy).
API_IMAGE=<conta>.dkr.ecr.us-east-2.amazonaws.com/eusindico-api:<tag>
WEB_IMAGE=<conta>.dkr.ecr.us-east-2.amazonaws.com/eusindico-web:<tag>

# Banco. Use só letras e números (o ";" quebraria a connection string). Gere com: openssl rand -hex 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Chave de assinatura do JWT (pelo menos 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET_KEY=

# Bucket S3 privado dos documentos e relatórios (criado na Fase 4).
S3_BUCKET_NAME=

# SMTP do Gmail: a conta e a SENHA DE APP dela (não a senha normal da conta).
SMTP_USUARIO=eusindico.contato@gmail.com
SMTP_SENHA=

# Grafana Cloud (opcional; vazio desativa a telemetria). Endpoint base, sem /v1/...
OTLP_ENDPOINT=
OTLP_HEADERS=
